{
  "schema": "jason-agent-infra.managed-project-workflow.v1",
  "project_id": "ccstatusline",
  "commands": {
    "source_lint": {
      "argv": ["bun", "run", "lint"],
      "cwd": ".",
      "timeout_seconds": 900,
      "mutates": []
    },
    "source_tests": {
      "argv": ["bun", "test", "--timeout=30000"],
      "cwd": ".",
      "timeout_seconds": 1800,
      "mutates": []
    }
  },
  "stages": [
    {
      "id": "project_workflow_lint",
      "stage": "project_workflow",
      "command": "source_lint",
      "depends_on": [],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "source",
      "error_catalog": ["CCSTATUSLINE_LINT_FAILED"]
    },
    {
      "id": "project_workflow_tests",
      "stage": "project_workflow",
      "command": "source_tests",
      "depends_on": ["project_workflow_lint"],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "source",
      "error_catalog": ["CCSTATUSLINE_TEST_FAILED"]
    }
  ],
  "docs": {
    "guide": ".jason-liao-agent-infra/README.md",
    "errors": ".jason-liao-agent-infra/errors.md"
  }
}
